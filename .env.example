# DASHBOARD_MODE selects which SQLite data file the app reads/writes.
# There is NO default — the app fails loudly at startup if this is unset
# or set to anything other than the two allowed values below.
#
# Allowed values:
#   demo  -> data/demo.sqlite  (invented, portfolio-safe fixture data)
#   real  -> data/real.sqlite  (your actual job search data — never commit this file)
DASHBOARD_MODE=
